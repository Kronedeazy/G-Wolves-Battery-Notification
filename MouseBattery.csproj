<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = no console window -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>MouseBattery</RootNamespace>
    <AssemblyName>MouseBattery</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Mouse Battery</Product>
    <Description>Battery notifications for G-Wolves mice (unofficial)</Description>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <!-- low memory use -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Release: one self-contained .exe, no .NET installation needed -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon shown in the notifications (G-Wolves logo). Embedded, so nothing is downloaded at runtime. -->
    <EmbeddedResource Include="assets\gwolves-logo.png" LogicalName="MouseBattery.notification.png" />
  </ItemGroup>

</Project>
